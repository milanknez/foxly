# Database (PostgreSQL)
POSTGRES_USER="foxly_user"
POSTGRES_PASSWORD="change_me_to_a_secure_password"
POSTGRES_DB="foxly_db"
DATABASE_URL="postgresql://foxly_user:change_me_to_a_secure_password@localhost:5432/foxly_db?schema=public"
DATABASE_URL_DOCKER="postgresql://foxly_user:change_me_to_a_secure_password@postgres:5432/foxly_db?schema=public"

# Object Storage (S3 / MinIO)
S3_ENDPOINT="localhost"
S3_ENDPOINT_DOCKER="minio"
S3_PORT="9005"
S3_USE_SSL="false"
S3_ACCESS_KEY="change_me_s3_key"
S3_SECRET_KEY="change_me_s3_secret"
S3_BUCKET="foxly-files"

# Authentication
NEXTAUTH_SECRET="change_me_to_a_secure_random_string"
NEXTAUTH_URL="http://localhost:3005"
